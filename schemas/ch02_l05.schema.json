{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tour.json-schema.org/content/02-Primitive-Types/05-Decimal-Numbers",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
