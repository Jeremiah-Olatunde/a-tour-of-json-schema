{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tour.json-schema.org/content/02-Primitive-Types/04-Exclusively-Constraining-Number",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
      "type": "integer",
      "exclusiveMinimum": 18,
      "exclusiveMaximum": 60
    },
    "salary": {
      "type": "integer",
      "exclusiveMinimum": 30000,
      "exclusiveMaximum": 80000
    }
  }
}
