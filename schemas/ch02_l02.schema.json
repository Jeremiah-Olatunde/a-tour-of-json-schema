{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tour.json-schema.org/content/02-Primitive-Types/02-Regular-Expressions-in-Strings",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "age": { "type": "integer" },
    "postalCode": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "phoneNumber": {
      "type": "string",
      "pattern": "^[0-9]{10,}$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
  }
}
